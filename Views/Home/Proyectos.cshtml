@{
    ViewData["Title"] = "Proyectos";
}

<section class="py-5 bg-light">

    <div class="container">

        <div class="text-center mb-5">

            <span class="badge bg-warning text-dark fs-6">
                Nuestro Portafolio
            </span>

            <h1 class="display-4 fw-bold mt-3">

                Proyectos Realizados

            </h1>

            <p class="lead text-secondary">

                Cada proyecto refleja nuestro compromiso con la calidad,
                la innovación y la satisfacción del cliente.

            </p>

        </div>

        <div class="text-center mb-5">

            <button class="btn btn-dark me-2">
                Todos
            </button>

            <button class="btn btn-outline-dark me-2">
                Residencial
            </button>

            <button class="btn btn-outline-dark me-2">
                Comercial
            </button>

            <button class="btn btn-outline-dark">
                Remodelación
            </button>

        </div>

        <div class="row g-4">

            <!-- Proyecto -->

            <div class="col-lg-4">

                <div class="card border-0 shadow h-100">

                    <img src="~/img/proyectos/1.jpg"
                         class="card-img-top">

                    <div class="card-body">

                        <span class="badge bg-warning text-dark">

                            Residencial

                        </span>

                        <h4 class="mt-3">

                            Casa Moderna Escazú

                        </h4>

                        <p class="text-secondary">

                            Escazú, San José

                        </p>

                        <a asp-controller="Home"
                           asp-action="DescProyecto"
                           class="btn btn-dark w-100">

                            Ver Proyecto

                        </a>

                    </div>

                </div>

            </div>

            <!-- Proyecto -->

            <div class="col-lg-4">

                <div class="card border-0 shadow h-100">

                    <img src="~/img/proyectos/2.jpg"
                         class="card-img-top">

                    <div class="card-body">

                        <span class="badge bg-primary">

                            Comercial

                        </span>

                        <h4 class="mt-3">

                            Torre Omega

                        </h4>

                        <p class="text-secondary">

                            Heredia

                        </p>

                        <a asp-controller="Home"
                           asp-action="ProyectoDetalle"
                           class="btn btn-dark w-100">

                            Ver Proyecto

                        </a>

                    </div>

                </div>

            </div>

            <!-- Proyecto -->

            <div class="col-lg-4">

                <div class="card border-0 shadow h-100">

                    <img src="~/img/proyectos/3.jpg"
                         class="card-img-top">

                    <div class="card-body">

                        <span class="badge bg-success">

                            Remodelación

                        </span>

                        <h4 class="mt-3">

                            Restaurante Terra

                        </h4>

                        <p class="text-secondary">

                            Santa Ana

                        </p>

                        <a asp-controller="Home"
                           asp-action="ProyectoDetalle"
                           class="btn btn-dark w-100">

                            Ver Proyecto

                        </a>

                    </div>

                </div>

            </div>

        </div>

    </div>

</section>