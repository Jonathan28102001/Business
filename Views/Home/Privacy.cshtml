            <p class="text-secondary">

                Ofrecemos soluciones completas para cualquier tipo de proyecto.

            </p>

        </div>

        <div class="row g-4">

            <div class="col-lg-4">

                <div class="card h-100 border-0 shadow">

                    <div class="card-body text-center p-5">

                        <i class="bi bi-building display-3 text-warning"></i>

                        <h4 class="mt-4">

                            Construcción

                        </h4>

