
@{
    ViewData["Title"] = "DescProyecto";
}


<!-- HERO -->

<section class="bg-dark text-white py-5">

    <div class="container">

        <a asp-controller="Home"
           asp-action="Proyectos" class="text-warning text-decoration-none">
            ← Volver al inicio
        </a>

        <div class="mt-4">

            <span class="badge bg-warning text-dark fs-6">
                Proyecto Residencial
            </span>

            <h1 class="display-3 fw-bold mt-3">
                Casa Moderna Escazú
            </h1>

            <p class="lead text-light">

                Proyecto de construcción residencial con diseño contemporáneo,
                acabados premium y espacios abiertos.

            </p>

        </div>

    </div>

</section>

<!-- IMAGEN PRINCIPAL -->

<section class="py-5">

    <div class="container">

        <img src="~/img/proyectos/principal.jpg"
             class="img-fluid rounded-4 shadow-lg w-100">

    </div>

</section>

<!-- INFORMACIÓN -->

<section class="pb-5">

    <div class="container">

        <div class="row">

            <div class="col-lg-8">

                <h2 class="fw-bold mb-4">

                    Descripción

                </h2>

                <p class="text-secondary fs-5">

                    Este proyecto fue desarrollado para una familia que buscaba una vivienda moderna,
                    amplia y funcional.

                    Se utilizaron materiales de primera calidad,
                    acabados de lujo y sistemas constructivos de alto rendimiento.

                    Nuestro equipo participó desde el diseño hasta la entrega final.

                </p>

            </div>

            <div class="col-lg-4">

                <div class="card border-0 shadow">

                    <div class="card-body p-4">

                        <h4 class="fw-bold">

                            Información

                        </h4>

                        <hr>

                        <p>

                            📍 Escazú, San José

                        </p>

                        <p>

                            📅 Finalizado en 2026

                        </p>

                        <p>

                            📐 Área: 420 m²

                        </p>

                        <p>

                            🏠 Tipo: Residencial

                        </p>

                        <p>

                            👷 Estado: Finalizado

                        </p>

                        <p>

                            ⭐ Garantía incluida

                        </p>

                    </div>

                </div>

            </div>

        </div>

    </div>

</section>

<!-- GALERÍA -->

<section class="bg-light py-5">

    <div class="container">

        <div class="text-center mb-5">

            <h2 class="fw-bold">

                Galería del Proyecto

            </h2>

            <p class="text-secondary">

                Conoce algunos momentos del desarrollo de la obra.

            </p>

        </div>

        <div class="row g-4">

            <div class="col-md-4">

                <img src="~/img/proyectos/1.jpg"
                     class="img-fluid rounded shadow">

            </div>

            <div class="col-md-4">

                <img src="~/img/proyectos/2.jpg"
                     class="img-fluid rounded shadow">

            </div>

            <div class="col-md-4">

                <img src="~/img/proyectos/3.jpg"
                     class="img-fluid rounded shadow">

            </div>

            <div class="col-md-4">

                <img src="~/img/proyectos/4.jpg"
                     class="img-fluid rounded shadow">

            </div>

            <div class="col-md-4">

                <img src="~/img/proyectos/5.jpg"
                     class="img-fluid rounded shadow">

            </div>

            <div class="col-md-4">

                <img src="~/img/proyectos/6.jpg"
                     class="img-fluid rounded shadow">

            </div>

        </div>

    </div>

</section>

<!-- VIDEO -->

<section class="py-5">

    <div class="container">

        <div class="text-center mb-5">

            <h2 class="fw-bold">

                Video del Proyecto

            </h2>

        </div>

