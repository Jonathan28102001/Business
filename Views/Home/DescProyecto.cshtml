                </p>

                <h5 class="mt-4">

                    Juan Pérez

                </h5>

                <p class="text-secondary">

                    Propietario

                </p>

            </div>

        </div>

    </div>

</section>

<!-- CTA -->

<section class="bg-warning py-5">

    <div class="container text-center">

        <h2 class="fw-bold">

            ¿Te gustó este proyecto?

        </h2>

        <p>

            Solicita una cotización y hagamos realidad tu idea.

        </p>

        <a href="#" class="btn btn-dark btn-lg px-5">

            Solicitar Cotización

        </a>

    </div>

</section>

